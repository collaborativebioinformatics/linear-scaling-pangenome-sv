{
  "name": "wfmash_test",
  "title": "WFMASH 2-pass diagnostic",
  "version": "0.2.0",
  "inputSpec": [
    {"name": "fasta", "class": "file", "patterns": ["*.fa","*.fasta"], "help": "Chunk FASTA"}
  ],
  "outputSpec": [
    {"name": "mappings_paf", "class": "file", "optional": true},
    {"name": "minimal_paf", "class": "file", "optional": true},
    {"name": "control_paf", "class": "file", "optional": true}
  ],
  "runSpec": {
    "interpreter": "bash",
    "file": "src/code.sh",
    "version": "0",
    "distribution": "Ubuntu",
    "release": "24.04",
    "systemRequirements": {"*": {"instanceType": "mem3_ssd1_v2_x16"}}
  },
  "access": {"network": ["*"]}
}