# Pipeline Environment Configuration
# Copy to .env and fill in your values.

# DNAnexus
DX_PROJECT_ID=
DX_WORKSPACE_ID=
DX_INSTANCE_TYPE=mem3_ssd1_v2_x16

# Pipeline
PIPELINE_MODE=smoke
PIPELINE_CHROMOSOME=chr21
PIPELINE_START=20000000
PIPELINE_END=21000000

# Resource limits
MAX_LOCAL_WORKERS=4
PGGB_THREADS=16

# Web
NEXT_PUBLIC_DATA_MODE=synthetic
